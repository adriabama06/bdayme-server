PORT=6570
# Docker service names are resolved via DNS like POSTGRES_HOST=db, and
# re-resolved every 30s (the proxy IP changes when its container is recreated).
# Also accepts single IPs, subnets (10.0.0.0/8) or loopback/uniquelocal.
TRUST_PROXY=traefik
CORS_ORIGIN=https://bdayme.duckdns.org,http://localhost:3000

# Max time (ms) in-flight requests have to finish on SIGTERM/scale-down.
# Must stay below stop_grace_period of the server service in compose.yml.
#SHUTDOWN_TIMEOUT_MS=30000

# Rate limiting for the auth endpoints (attempts per window)
REGISTER_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_MAX=5

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=bdayme
POSTGRES_USER=bdayme
POSTGRES_PASSWORD=bdaymepass

REDIS_HOST=redis
REDIS_PORT=6379
